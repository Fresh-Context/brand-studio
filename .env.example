# Fresh Context Studio — environment
PORT=3440

# Supabase — the contextListener project
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# OpenAI — gpt-image-2 generation + vision captions + embeddings
OPENAI_API_KEY=

# Bearer token gating /api/* (the machine / MCP door). Generate a strong random
# string. If unset in dev, /api is OPEN — never leave unset in production.
STUDIO_BEARER_TOKEN=

# MCP server target. The MCP server (mcp/server.js) is a thin client of this API.
# Local dev defaults to the local server; in production point at the deployed URL.
STUDIO_API_URL=http://localhost:3440

# Storage locations. Local dev falls back to a gitignored data/ dir inside
# this checkout (create it, or point these at real dirs / seed data from
# Sam). In the Coolify container these become a persistent volume
# (generated/references) and a repo mount (library). Paths are relative to
# the repo root or absolute.
STUDIO_GENERATED_DIR=data/generated
STUDIO_REFERENCES_DIR=data/references
STUDIO_LIBRARY_DIR=data/library
