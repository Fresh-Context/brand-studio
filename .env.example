# Fresh Context Studio — environment
PORT=3440

# Supabase — the contextListener project
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# OpenAI — gpt-image-2 generation + vision captions + embeddings
OPENAI_API_KEY=

# Bearer token gating /api/* and the hosted /mcp machine door. Generate a strong
# random value and keep it in the approved secret manager or this untracked file.
STUDIO_BEARER_TOKEN=

# Optional dedicated HMAC secret for short-lived signed MCP output URLs. If
# unset, STUDIO_BEARER_TOKEN is used as the signing secret.
STUDIO_DOWNLOAD_SIGNING_SECRET=

# MCP target. Local stdio defaults to localhost only when this is omitted;
# production-targeted clients set https://studio.freshcontext.ai.
STUDIO_API_URL=http://localhost:3440
STUDIO_MCP_REQUEST_TIMEOUT_MS=180000
STUDIO_MCP_SIGNED_URL_TTL_SECONDS=300

# Optional allowlist for hosted input_image https_url values, comma-separated.
STUDIO_MCP_ALLOWED_IMAGE_HOSTS=

# Storage locations. Local dev falls back to a gitignored data/ dir inside this
# checkout. In Coolify these are persistent volume/repo mounts. Paths may be
# relative to the repo root or absolute.
STUDIO_GENERATED_DIR=data/generated
STUDIO_REFERENCES_DIR=data/references
STUDIO_LIBRARY_DIR=data/library
