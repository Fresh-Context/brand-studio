{
  "name": "@freshcontext/studio",
  "version": "0.1.0",
  "private": true,
  "description": "Fresh Context Studio — brand operating surface (asset gallery + search + generation). API-first; UI + MCP over the same endpoints. See STUDIO-PRD.md.",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "build": "node scripts/build-identity-embed.js",
    "predev": "node scripts/build-identity-embed.js",
    "prestart": "node scripts/build-identity-embed.js",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "index": "node scripts/index-assets.js",
    "mcp:smoke": "node mcp/smoke-test.js",
    "mcp:hosted-smoke": "node mcp/hosted-smoke.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.104.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.0",
    "image-size": "^1.1.1",
    "marked": "^12.0.0",
    "multer": "^2.0.1"
  }
}
